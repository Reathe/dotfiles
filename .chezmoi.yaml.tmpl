{{- $BWS_ACCESS_TOKEN := env "BWS_ACCESS_TOKEN" -}}
{{- if not $BWS_ACCESS_TOKEN -}}
{{-   $BWS_ACCESS_TOKEN = promptStringOnce . "BWS_ACCESS_TOKEN" "Write your BWS_ACCESS_TOKEN" -}}
{{- end -}}
# scriptEnv overrides the shell's variables, so the scripts' switches stay out of it and are set per run:
# INSTALL_PACKAGES=false, BWS_REINSTALL=true, BWS_SHOW_INSTALLER=true chezmoi apply
scriptEnv:
  BWS_ACCESS_TOKEN: {{ $BWS_ACCESS_TOKEN | quote }}

data:
  FORCE_RUN_ONCHANGE: "false"
  INSTALL_EXTRAS: "false"
  BWS_ACCESS_TOKEN: {{ $BWS_ACCESS_TOKEN | quote }}

{{ if eq .chezmoi.os "windows" -}}
hooks:
  read-source-state:
    pre:
      command: "powershell"
      args:
        [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{{ .chezmoi.sourceDir }}/.install-pw-manager.ps1",
        ]

interpreters:
  # nushell comes from mise; `mise x` installs it on first use, so this works before mise install has run
  nu:
    command: "{{ .chezmoi.homeDir }}/AppData/Local/Microsoft/WinGet/Links/mise.exe"
    args: ["x", "nushell", "--", "nu"]

{{ else if and (eq .chezmoi.os "linux") (ne .chezmoi.osRelease.name "NixOS") -}}
hooks:
  read-source-state:
    pre:
      command: "sh"
      args:
        [
          "{{ .chezmoi.sourceDir }}/.install-pw-manager.sh"
        ]
{{ end -}}
