{{ if eq .chezmoi.os "windows" -}}
:: Installs the tools listed in ~/.config/mise (named "1_" so it runs before the other after-scripts).
:: mise config hash: {{ include "dot_config/mise/.config.toml" | sha256sum }}
{{ if eq .FORCE_RUN_ONCHANGE "true" -}}
:: random string to force run the script {{ randAlphaNum 50 }}
{{- end }}
@echo off

if /I "%INSTALL_PACKAGES%"=="false" (
    echo Package installation is disabled: INSTALL_PACKAGES = 'false'
    goto :eof
)

:: mise may have been installed by winget during this same apply, so PATH is not refreshed yet
where mise >nul 2>nul || set "PATH=%LOCALAPPDATA%\Microsoft\WinGet\Links;%PATH%"

:: Put the mise shims on the persistent user PATH, so tools resolve outside an activated shell
:: (whkd running komorebic, startup shortcuts, GUI apps). setx would truncate PATH at 1024 chars.
powershell -NoProfile -Command "$s = $env:LOCALAPPDATA + '\mise\shims'; $p = [Environment]::GetEnvironmentVariable('Path', 'User'); if (($p -split ';') -notcontains $s) { [Environment]::SetEnvironmentVariable('Path', $s + ';' + $p, 'User') }"
set "PATH=%LOCALAPPDATA%\mise\shims;%PATH%"

@echo on
mise install --yes
mise exec -- uv python install --default --preview
@echo off

echo mise install done: errorlevel=%errorlevel%
{{ end }}
