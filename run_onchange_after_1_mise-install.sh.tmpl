{{ if and (eq .chezmoi.os "linux") (ne .chezmoi.osRelease.name "NixOS") -}}

#!{{ lookPath "bash" }}
# Installs the tools listed in ~/.config/mise (named "1_" so it runs before the other after-scripts).
{{ if eq .FORCE_RUN_ONCHANGE "true" -}}
# random string to force run the script {{ randAlphaNum 50 }}
{{- end }}
# mise config hash: {{ include "dot_config/mise/.config.toml" | sha256sum }}
# mise lock hash: {{ include "dot_config/mise/.mise.lock" | sha256sum }}
set -e
if [ "$INSTALL_PACKAGES" = "false" ]; then
  echo "Package installation is disabled: INSTALL_PACKAGES = 'false'"
  exit 0
fi

# Omarchy ships mise; elsewhere install it to ~/.local/bin
if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

# Authenticated GitHub API calls: the anonymous limit (60/h) can fail a fresh install, and gh
# (which would provide a token) is itself installed here. Same token run_after_gh_auth logs in with, fetched
# when this runs rather than rendered in, so `chezmoi cat` and `apply -v` don't print it.
# TSV: a header line, then ID, Key, Value, Creation Date.
GITHUB_TOKEN=$(bws secret get 90a30c12-3351-49be-9e4c-b3e400e715ef -o tsv | sed -n 2p | cut -f 3)
[ -n "$GITHUB_TOKEN" ] || { echo "Could not read the GitHub token with bws"; exit 1; }
export GITHUB_TOKEN
mise install --yes --locked
# kanata.service (dot_config/systemd/user) runs the kanata just installed; nothing else turns it on
systemctl --user enable --now kanata.service || echo "kanata.service did not start: systemctl --user status kanata"
{{- end -}}
