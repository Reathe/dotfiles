{{ if eq .chezmoi.os "windows" -}}
use std/log
# mise may have been installed during this apply
use ~/.config/nushell/custom-commands.nu refreshpath
refreshpath
log debug "Checking if Kanata is set to run on startup"
# Making kanata run on startup by placing link to its .exe in startup folder
let startupFolder = ($env.APPDATA | path join "Microsoft\\Windows\\Start Menu\\Programs\\Startup\\Kanata")

# path exists follows the link, so a link left dangling by an uninstall counts as missing
if not ($startupFolder | path exists) or not ($startupFolder | path expand | str contains "mise") {
  # kanata is installed by mise; link the real exe, not a mise shim
  let kanataPath = (mise which {{ .kanataExe }} | str trim | str replace -a \ \\)
  log info $"setting kanata in startup folder ($kanataPath)"
  rm -f $startupFolder
  cmd /c mklink $startupFolder $kanataPath
} else {
  log debug "Kanata link already in startup folder"
}

# komorebi is installed by mise; point its startup shortcut at the shim so it survives upgrades
let komorebiShim = ($env.LOCALAPPDATA | path join "mise\\shims\\komorebic-no-console.exe")
let komorebiLnk = ($env.APPDATA | path join "Microsoft\\Windows\\Start Menu\\Programs\\Startup\\komorebi.lnk")
log debug $"setting komorebi startup shortcut to ($komorebiShim)"
powershell -NoProfile -Command $"$l = \(New-Object -ComObject WScript.Shell\).CreateShortcut\('($komorebiLnk)'\); $l.TargetPath = '($komorebiShim)'; $l.Arguments = 'start --ffm --bar --whkd'; $l.Save\(\)"
{{- end }}
