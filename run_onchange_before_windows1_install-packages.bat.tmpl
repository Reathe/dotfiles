{{ if eq .chezmoi.os "windows" -}}
:: Only what mise can't install (GUI installers, compiler, fonts, bootstrap). Everything else: ~/.config/mise.
{{ if eq .FORCE_RUN_ONCHANGE "true" -}}
:: random string to force run the script {{ randAlphaNum 50 }}
{{- end }}
setx XDG_CONFIG_HOME %userprofile%\.config 
setx KOMOREBI_CONFIG_HOME %userprofile%\.config\komorebi
@echo off

if /I "%INSTALL_PACKAGES%"=="false" (
    echo Package installation is disabled: INSTALL_PACKAGES = 'false'
    goto :eof
)

:: Enable sudo
echo You should run the program as Administrator
echo install winget packages

:: jdx.mise: installs everything else (see run_onchange_after_1_mise-install)
:: git.git: mise needs git itself
:: BrechtSanders.WinLibs: C compiler for tree-sitter
@echo on
winget install jdx.mise git.git BrechtSanders.WinLibs.POSIX.UCRT -s winget --accept-package-agreements --accept-source-agreements -h --disable-interactivity

{{ if eq .INSTALL_EXTRAS "true" -}}
winget install AntibodySoftware.WizTree voidtools.Everything Microsoft.VisualStudioCode Zen-Team.Zen-Browser -s winget --accept-package-agreements --accept-source-agreements -h --disable-interactivity
{{ end -}}

winget install Chocolatey.Chocolatey -s winget --accept-package-agreements --accept-source-agreements -h --disable-interactivity
@echo off

echo install choco packages
@echo on
"C:\ProgramData\chocolatey\choco.exe" install -y nerd-fonts-jetbrainsmono
@echo off

echo Install done: errorlevel=%errorlevel%
{{ end }}
