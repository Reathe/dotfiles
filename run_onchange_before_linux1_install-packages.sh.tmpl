{{ if eq .chezmoi.os "linux" -}}

#!{{ lookPath "bash" }}
{{ if eq .FORCE_RUN_ONCHANGE "true" -}}
# random string to force run the script {{ randAlphaNum 50 }}
{{- end }}

{{- if eq .chezmoi.osRelease.name "NixOS" }}
# nix files hash: {{ include "flake.lock" | sha256sum }}
# nix files hash: {{ include "flake.nix" | sha256sum }}
# nix files hash: {{ include ".chezmoitemplates/kanata.kbd" | sha256sum }}
# nix files hash: {{ include ".nix/modules/common.nix" | sha256sum }}
# nix files hash: {{ include ".nix/modules/raf-user.nix" | sha256sum }}
# nix files hash: {{ include ".nix/modules/unstable-overlay.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/desktop/default.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/desktop/hardware-configuration.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/vm/default.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/vm/hardware-configuration.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/wsl/default.nix" | sha256sum }}
flake_host="$(hostname)"
if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
  flake_host="nixos-wsl"
fi
case "$flake_host" in
nixos | nixos-vm | nixos-wsl) ;;
*) flake_host="nixos" ;;
esac
sudo nixos-rebuild switch --flake path:{{ .chezmoi.sourceDir }}#"$flake_host"
{{- else -}}
# Package List Hash {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# install curl if needed
{{ if contains "debian" .chezmoi.osRelease.idLike }}
sudo apt install curl git build-essential
{{ end -}}

# install brew if needed
if ! command -v brew 2>&1 >/dev/null; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  echo >>~/.bashrc
  echo 'eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' >>~/.bashrc
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# install brew taps
brew tap {{ range .packages.linux.brewtap -}}{{ . }} {{ end }}
# install individual packages
brew install {{ range .packages.linux.brew -}}{{ . }} {{ end }}
{{- end -}}

{{- end -}}
