{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.name "NixOS") -}}

#!{{ lookPath "bash" }}
{{ if eq .FORCE_RUN_ONCHANGE "true" -}}
# random string to force run the script {{ randAlphaNum 50 }}
{{- end }}
# nix files hash: {{ include "flake.lock" | sha256sum }}
# nix files hash: {{ include "flake.nix" | sha256sum }}
# nix files hash: {{ include ".chezmoitemplates/kanata.kbd" | sha256sum }}
# nix files hash: {{ include ".nix/modules/common.nix" | sha256sum }}
# nix files hash: {{ include ".nix/modules/raf-user.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/desktop/default.nix" | sha256sum }}
# nix files hash: {{ include ".nix/hosts/desktop/hardware-configuration.nix" | sha256sum }}
# nh shows a package diff; plain nixos-rebuild on a fresh install that has no nh yet.
# A plain path is read as git+file, by root too: only tracked files are copied to the store, not .jj or worktrees.
if command -v nh >/dev/null; then
	nh os switch {{ .chezmoi.sourceDir }} -H nixos
else
	sudo nixos-rebuild switch --flake {{ .chezmoi.sourceDir }}#nixos
fi
{{- end -}}
