alias vim = nvim
alias vi = vim
alias cat = bat
alias cm = chezmoi
alias zj = zellij
alias sshp = ssh -D 1080 -N

{{- /* For platform specific aliases to add */ -}}

{{- if eq .chezmoi.os "windows" }}
alias cma = sudo chezmoi apply --init
alias kanata = {{ .kanataExe }}
{{ end -}}

{{- if eq .chezmoi.os "linux" }}
alias cma = chezmoi apply --init
alias sudopath = sudo --preserve-env=PATH env
{{- if eq .chezmoi.osRelease.name "NixOS" }}
alias nrs = nh os switch
{{- else }}
# mise's kanata zip has no plain `kanata`; on NixOS kanata is the system service's
alias kanata = kanata_linux_x64
{{- end }}
{{ end -}}
