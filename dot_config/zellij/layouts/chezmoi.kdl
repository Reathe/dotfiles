layout {
  cwd "~/.local/share/chezmoi"

  tab name="chezmoi" focus=true hide_floating_panes=true {
    pane size=1 borderless=true {
      plugin location="tab-bar"
    }
    floating_panes {
      pane {
        height "90%"
        width "90%"
        x "5%"
        y "5%"
      }
    }
    pane stacked=true {
      pane name="nvim" command="nvim" expanded=true
      pane cwd="~/.config"
    }
    pane size=1 borderless=true {
      plugin location="status-bar"
    }
  }

  tab name="ai" hide_floating_panes=true {
    pane size=1 borderless=true {
      plugin location="tab-bar"
    }
    pane command="codex"
    pane size=1 borderless=true {
      plugin location="status-bar"
    }
  }
}
